    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && node ./node_modules/vite/bin/vite.js build",
    "seed-production": "tsx prisma/seed-production.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
