    "@vitejs/plugin-react": "4.3.4",
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^11.2.12",
    "lucide-react": "^0.469.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "prisma": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.8.2",
    "vite": "5.4.11"
  },
  "devDependencies": {
