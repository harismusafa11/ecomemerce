{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "rewrites": [
        {
            "source": "/api/login",
            "destination": "/api/login"
        },
        {
            "source": "/api/register",
            "destination": "/api/register"
        },
        {
            "source": "/api/products(.*)",
            "destination": "/api/products"
        },
        {
            "source": "/api/users(.*)",
            "destination": "/api/users"
        },
        {
            "source": "/api/cart(.*)",
            "destination": "/api/cart"
        },
        {
            "source": "/api/orders(.*)",
            "destination": "/api/orders"
        },
        {
            "source": "/api/wishlist(.*)",
            "destination": "/api/wishlist"
        },
        {
            "source": "/api/vouchers(.*)",
            "destination": "/api/vouchers"
        },
        {
            "source": "/api/ongkir(.*)",
            "destination": "/api/ongkir"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/index"
        },
        {
            "source": "/robots.txt",
            "destination": "/api/index"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}