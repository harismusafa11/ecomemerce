{
    "version": 2,
    "buildCommand": "node ./node_modules/vite/bin/vite.js build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "functions": {
        "api/index.ts": {
            "includeFiles": "server/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/index"
        },
        {
            "source": "/robots.txt",
            "destination": "/api/index"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}