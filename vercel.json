{
    "version": 2,
    "buildCommand": "node ./node_modules/vite/bin/vite.js build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "functions": {
        "api/**/*.ts": {
            "includeFiles": "{server,lib,prisma}/**"
        }
    },
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/index?path=sitemap.xml"
        },
        {
            "source": "/robots.txt",
            "destination": "/api/index?path=robots.txt"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}