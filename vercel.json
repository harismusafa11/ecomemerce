{
    "rewrites": [
        {
            "source": "/api/login",
            "destination": "/api/login"
        },
        {
            "source": "/api/register",
            "destination": "/api/register"
        },
        {
            "source": "/api/cart(.*)",
            "destination": "/api/cart"
        },
        {
            "source": "/api/orders(.*)",
            "destination": "/api/orders"
        },
        {
            "source": "/api/wishlist(.*)",
            "destination": "/api/wishlist"
        },
        {
            "source": "/api/vouchers",
            "destination": "/api/vouchers"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}