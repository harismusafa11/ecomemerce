# Database Configuration (Prisma Accelerate)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_API_KEY"

# Server Configuration
PORT=3001
NODE_ENV=production

# Security
# Add your production domain here
ALLOWED_ORIGINS="https://tapakpamungkas.com,https://www.tapakpamungkas.com"
# Salt used to sign auth tokens & hash passwords. Set a long random value in production.
SECURITY_SALT="tapak_pamungkas_auth_salt_v1_2026"

# Shipping (optional) - live RajaOngkir-style location search via Binderbyte.
# Leave empty to fall back to the built-in tariff matrix.
BINDERBYTE_API_KEY=""

# Optional: Add more security configurations
# JWT_SECRET=your_jwt_secret_here
# SESSION_SECRET=your_session_secret_here
