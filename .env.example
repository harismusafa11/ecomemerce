# Database Configuration (Prisma Accelerate)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_API_KEY"

# Server Configuration
PORT=3001
NODE_ENV=production

# Security (REQUIRED - no default values)
# Salt used to sign auth tokens & hash passwords. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECURITY_SALT=""
# Secret key for Better Auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Allowed origins for CORS
ALLOWED_ORIGINS="https://tapakpamungkas.my.id,https://tapakpamungkas.com"

# Better Auth base URL
BETTER_AUTH_URL="https://tapakpamungkas.my.id"

# Shipping (optional) - live RajaOngkir-style location search via Binderbyte.
# Leave empty to fall back to the built-in tariff matrix.
BINDERBYTE_API_KEY=""
